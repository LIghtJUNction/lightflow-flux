#!/bin/sh
set -eu

sd_cli="${LIGHTFLOW_SD_CLI:-${SD_CLI:-sd-cli}}"
task="text-to-image"
prompt=""
negative=""
width="512"
height="512"
seed="42"
steps="4"
guidance="3.5"
cfg_scale="1.0"
strength="0.75"
output=""
flux_model=""
llm_model=""
vae_model=""
image=""
mask=""

fail() {
  printf '%s\n' "$1" >&2
  exit "${2:-2}"
}

require_file() {
  label="$1"
  path="$2"
  if [ ! -f "$path" ]; then
    fail "LightFlow FLUX runner could not find $label: $path" 2
  fi
  if [ ! -r "$path" ]; then
    fail "LightFlow FLUX runner cannot read $label: $path" 2
  fi
}

require_sd_cli() {
  case "$sd_cli" in
    */*)
      if [ ! -x "$sd_cli" ]; then
        fail "LightFlow FLUX runner could not execute sd-cli at: $sd_cli
Set LIGHTFLOW_SD_CLI=/path/to/stable-diffusion.cpp/build/bin/sd-cli or make the file executable." 2
      fi
      ;;
    *)
      if ! command -v "$sd_cli" >/dev/null 2>&1; then
        fail "LightFlow FLUX runner could not find sd-cli on PATH.
Set LIGHTFLOW_SD_CLI=/path/to/stable-diffusion.cpp/build/bin/sd-cli or put sd-cli on PATH." 2
      fi
      ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --task)
      shift
      task="$1"
      ;;
    --prompt)
      shift
      prompt="$1"
      ;;
    --negative)
      shift
      negative="$1"
      ;;
    --width)
      shift
      width="$1"
      ;;
    --height)
      shift
      height="$1"
      ;;
    --seed)
      shift
      seed="$1"
      ;;
    --steps)
      shift
      steps="$1"
      ;;
    --guidance)
      shift
      guidance="$1"
      ;;
    --cfg-scale)
      shift
      cfg_scale="$1"
      ;;
    --strength)
      shift
      strength="$1"
      ;;
    --output)
      shift
      output="$1"
      ;;
    --image)
      shift
      image="$1"
      ;;
    --mask)
      shift
      mask="$1"
      ;;
    --flux-model)
      shift
      flux_model="$1"
      ;;
    --llm-model)
      shift
      llm_model="$1"
      ;;
    --vae-model)
      shift
      vae_model="$1"
      ;;
    *)
      printf 'unknown LightFlow FLUX runner argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
  shift
done

if [ -z "$prompt" ] || [ -z "$output" ] || [ -z "$flux_model" ] || [ -z "$llm_model" ] || [ -z "$vae_model" ]; then
  fail 'missing required LightFlow FLUX runner argument' 2
fi

case "$task" in
  text-to-image)
    ;;
  image-edit)
    if [ -z "$image" ]; then
      fail 'image-edit requires --image' 2
    fi
    ;;
  inpaint)
    if [ -z "$image" ] || [ -z "$mask" ]; then
      fail 'inpaint requires --image and --mask' 2
    fi
    ;;
  *)
    fail "unsupported LightFlow FLUX task: $task" 2
    ;;
esac

require_sd_cli
require_file "FLUX model" "$flux_model"
require_file "LLM model" "$llm_model"
require_file "VAE model" "$vae_model"

if [ -n "$image" ]; then
  require_file "input image" "$image"
fi

if [ -n "$mask" ]; then
  require_file "input mask" "$mask"
fi

mkdir -p "$(dirname "$output")"

set -- \
  --diffusion-model "$flux_model" \
  --llm "$llm_model" \
  --vae "$vae_model" \
  --vae-format flux2 \
  --prompt "$prompt" \
  --negative-prompt "$negative" \
  --width "$width" \
  --height "$height" \
  --seed "$seed" \
  --steps "$steps" \
  --guidance "$guidance" \
  --cfg-scale "$cfg_scale" \
  --output "$output" \
  --vae-tiling \
  --mmap \
  --offload-to-cpu

if [ -n "$image" ]; then
  set -- "$@" --init-img "$image" --strength "$strength"
fi

if [ -n "$mask" ]; then
  set -- "$@" --mask "$mask"
fi

exec "$sd_cli" "$@"
